# modbus_slave.service — systemd unit for Modbus RTU slave emulator
#
# Install:
#   sudo cp modbus_slave /usr/local/bin/
#   sudo cp modbus_slave.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable modbus_slave
#   sudo systemctl start modbus_slave
#
# Control:
#   sudo systemctl start   modbus_slave
#   sudo systemctl stop    modbus_slave
#   sudo systemctl restart modbus_slave
#   sudo systemctl status  modbus_slave
#
# Logs:
#   journalctl -u modbus_slave -f

[Unit]
Description=Modbus RTU Slave Emulator
Documentation=https://github.com/YOUR_USERNAME/modbus_slave
# Start after the serial port subsystem is ready
After=dev-ttyS7.device
Wants=dev-ttyS7.device

[Service]
Type=simple
ExecStart=/usr/local/bin/modbus_slave \
    -p /dev/ttyS7 \
    -b 115200 \
    -o 8N1 \
    -a 1
Restart=on-failure
RestartSec=5
# Give the port time to appear after reboot
TimeoutStartSec=30

# Run as root to access /dev/ttyS7
# If your user is in the 'dialout' group you can change to:
#   User=your_username
#   Group=dialout

# Logging goes to syslog/journald automatically via stdout
StandardOutput=journal
StandardError=journal
SyslogIdentifier=modbus_slave

[Install]
WantedBy=multi-user.target
